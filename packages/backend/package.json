    "@fastify/cors": "^9.0.0",
    "drizzle-orm": "^0.33.0",
    "better-sqlite3": "^11.0.0",
    "ulid": "^2.3.0",
    "openai": "^4.50.0",
    "node-ssh": "^13.2.0",
    "keytar": "^7.9.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.15.0",
    "tsup": "^8.1.0",
    "vitest": "^1.6.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.24.0"
  }
